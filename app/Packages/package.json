{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "db:fresh": "bash scripts/fresh-migrate.sh",
    "test": "npm run db:fresh && npx playwright test",
    "test:fresh": "npm test",
    "test:packages": "npm run db:fresh && npx playwright test tests/remaining-packages-routes.spec.js",
    "test:packages:docs": "npm run db:fresh && PLAYWRIGHT_DOCS_VIDEO=1 npx playwright test tests/remaining-packages-routes.spec.js",
    "test:bundle": "npm run db:fresh && npx playwright test tests/remaining-packages-routes.spec.js --grep",
    "test:timetable": "npm run db:fresh && npx playwright test tests/timetable-management-routes.spec.js",
    "test:headed": "npm run db:fresh && npx playwright test --headed",
    "test:ui": "npm run db:fresh && npx playwright test --ui",
    "test:debug": "npm run db:fresh && npx playwright test --debug",
    "report": "npx playwright show-report",

    "record:install": "pip3 install edge-tts --break-system-packages",
    "record:all": "node scripts/record-all-docs.js",

    "record:attendance": "npm run db:fresh && node scripts/record-doc.js tests/docs/attendance-management-walkthrough.spec.js",
    "record:timetable": "npm run db:fresh && node scripts/record-doc.js tests/docs/timetable-management-walkthrough.spec.js",
    "record:classes": "npm run db:fresh && node scripts/record-doc.js tests/docs/class-management-walkthrough.spec.js",
    "record:students": "npm run db:fresh && node scripts/record-doc.js tests/docs/student-management-walkthrough.spec.js",
    "record:staff": "npm run db:fresh && node scripts/record-doc.js tests/docs/staff-management-walkthrough.spec.js",
    "record:subjects": "npm run db:fresh && node scripts/record-doc.js tests/docs/subject-management-walkthrough.spec.js",
    "record:exams": "npm run db:fresh && node scripts/record-doc.js tests/docs/exam-management-walkthrough.spec.js",
    "record:fees": "npm run db:fresh && node scripts/record-doc.js tests/docs/fee-management-walkthrough.spec.js",
    "record:communication": "npm run db:fresh && node scripts/record-doc.js tests/docs/communication-management-walkthrough.spec.js",
    "record:hostel": "npm run db:fresh && node scripts/record-doc.js tests/docs/hostel-transport-walkthrough.spec.js",
    "record:rbac": "npm run db:fresh && node scripts/record-doc.js tests/docs/rbac-management-walkthrough.spec.js",
    "record:data-transfer": "npm run db:fresh && node scripts/record-doc.js tests/docs/data-transfer-walkthrough.spec.js",
    "record:webhook": "npm run db:fresh && node scripts/record-doc.js tests/docs/webhook-walkthrough.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0"
  }
}
