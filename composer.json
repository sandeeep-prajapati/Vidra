{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "league/commonmark": "^2.8",
        "spatie/laravel-permission": "^7.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "knuckleswtf/scribe": "^5.9",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Packages\\AttendanceManagement\\": "app/Packages/AttendanceManagement/src/",
            "App\\Packages\\BundleInstaller\\": "app/Packages/BundleInstaller/src/",
            "App\\Packages\\ClassManagement\\": "app/Packages/ClassManagement/src/",
            "App\\Packages\\CommunicationManagement\\": "app/Packages/CommunicationManagement/src/",
            "App\\Packages\\ContactBundle\\": "app/Packages/ContactBundle/src/",
            "App\\Packages\\CorePackage\\": "app/Packages/CorePackage/src/",
            "App\\Packages\\DataTransfer\\": "app/Packages/DataTransfer/src/",
            "App\\Packages\\ExamManagement\\": "app/Packages/ExamManagement/src/",
            "App\\Packages\\FeeManagement\\": "app/Packages/FeeManagement/src/",
            "App\\Packages\\HostelTransportManagement\\": "app/Packages/HostelTransportManagement/src/",
            "App\\Packages\\Installer\\": "app/Packages/Installer/src/",
            "App\\Packages\\Pro\\AdmissionManagement\\": "app/Packages/Pro/AdmissionManagement/src",
            "App\\Packages\\Pro\\AlumniManagement\\": "app/Packages/Pro/AlumniManagement/src",
            "App\\Packages\\Pro\\AnalyticsBundle\\": "app/Packages/Pro/AnalyticsBundle/src",
            "App\\Packages\\Pro\\AuditManagement\\": "app/Packages/Pro/AuditManagement/src",
            "App\\Packages\\Pro\\BehaviorManagement\\": "app/Packages/Pro/BehaviorManagement/src",
            "App\\Packages\\Pro\\EventManagement\\": "app/Packages/Pro/EventManagement/src",
            "App\\Packages\\Pro\\ExtracurricularManagement\\": "app/Packages/Pro/ExtracurricularManagement/src",
            "App\\Packages\\Pro\\GrievanceManagement\\": "app/Packages/Pro/GrievanceManagement/src",
            "App\\Packages\\Pro\\HealthManagement\\": "app/Packages/Pro/HealthManagement/src",
            "App\\Packages\\Pro\\HomeworkManagement\\": "app/Packages/Pro/HomeworkManagement/src",
            "App\\Packages\\Pro\\InventoryManagement\\": "app/Packages/Pro/InventoryManagement/src",
            "App\\Packages\\Pro\\LibraryManagement\\": "app/Packages/Pro/LibraryManagement/src",
            "App\\Packages\\Pro\\PTMManagement\\": "app/Packages/Pro/PTMManagement/src",
            "App\\Packages\\Pro\\ReportsManagement\\": "app/Packages/Pro/ReportsManagement/src",
            "App\\Packages\\Pro\\TransportGpsManagement\\": "app/Packages/Pro/TransportGpsManagement/src",
            "App\\Packages\\RbacManagement\\": "app/Packages/RbacManagement/src/",
            "App\\Packages\\StaffManagement\\": "app/Packages/StaffManagement/src/",
            "App\\Packages\\StudentManagement\\": "app/Packages/StudentManagement/src/",
            "App\\Packages\\SubjectManagement\\": "app/Packages/SubjectManagement/src/",
            "App\\Packages\\TimetableManagement\\": "app/Packages/TimetableManagement/src/",
            "App\\Packages\\Webhook\\": "app/Packages/Webhook/src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
